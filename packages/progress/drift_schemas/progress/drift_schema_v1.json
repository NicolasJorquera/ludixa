  "fixed_sql": [
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"game_id\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"mode\" TEXT NOT NULL, \"started_at_ms\" INTEGER NOT NULL, \"start_offset_min\" INTEGER NOT NULL, \"challenge_date\" TEXT NULL, \"seed\" TEXT NOT NULL, \"generator_version\" INTEGER NOT NULL, \"words_lang\" TEXT NULL, \"puzzle_json\" TEXT NOT NULL, \"state_json\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"elapsed_ms\" INTEGER NOT NULL, \"hints_free\" INTEGER NOT NULL, \"hints_rewarded\" INTEGER NOT NULL, \"rescued\" INTEGER NOT NULL CHECK (\"rescued\" IN (0, 1)), \"completed_at_ms\" INTEGER NULL, \"theme_ids_json\" TEXT NOT NULL, \"flags_placed\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "daily_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_days\" (\"local_date\" TEXT NOT NULL, \"tz_offset_min\" INTEGER NOT NULL, \"completed_games\" TEXT NOT NULL, \"archive_games\" TEXT NOT NULL, \"saver_used\" INTEGER NOT NULL CHECK (\"saver_used\" IN (0, 1)), PRIMARY KEY (\"local_date\"));"
        }
      ]
    },
    {
      "name": "streak",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"streak\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"current\" INTEGER NOT NULL, \"best\" INTEGER NOT NULL, \"savers\" INTEGER NOT NULL, \"last_counted_date\" TEXT NULL, \"last_offset_min\" INTEGER NOT NULL, \"previous\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "achievements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"achievements\" (\"id\" TEXT NOT NULL, \"unlocked_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "stats_resets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stats_resets\" (\"game_id\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"reset_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"game_id\", \"difficulty\"));"
        }
      ]
    },
    {
      "name": "sessions_game_level",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX sessions_game_level ON sessions (game_id, difficulty)"
        }
      ]
    },
    {
      "name": "sessions_challenge",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX sessions_challenge ON sessions (challenge_date)"
        }
      ]
    },
    {
      "name": "sessions_status",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX sessions_status ON sessions (status)"
        }
      ]
    }
